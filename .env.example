# Elija UNA de las dos credenciales (también puede dejarlas vacías y pegarla en la página, sección Conexión).

# Opción A (recomendada): token de su suscripción de Claude. Se genera en su equipo con:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Opción B: API key de Anthropic (se cobra por uso). Se crea en https://console.anthropic.com
ANTHROPIC_API_KEY=
